@* Define the common layout used by all pages. *@
<!DOCTYPE html>

<html lang="en">

<head>

    @* Set the character encoding. *@
    <meta charset="utf-8" />

    @* Make the website responsive on different screen sizes. *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* Display the current page title. *@
    <title>@ViewData["Title"] - City Care Hospital</title>

    @* Load Bootstrap CSS from the local project. *@
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @* Load the application's custom CSS file. *@
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    @* Create the navigation bar. *@
    <nav class="navbar navbar-expand-lg modern-navbar">

        <div class="container">

            @* Display the hospital name. *@
            <a class="navbar-brand hospital-name"
               asp-controller="Home"
               asp-action="Index">

                <span class="hospital-icon">+</span>
                City Care Hospital

            </a>

            @* Create the mobile navigation button. *@
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            @* Display the navigation menu. *@
            <div class="collapse navbar-collapse"
                 id="mainNavigation">

                <div class="navbar-nav ms-auto">

                    @* Link to the doctor list. *@
                    <a class="nav-link modern-nav-link"
                       asp-controller="Home"
                       asp-action="Index">
                        Doctors
                    </a>

                    @* Link to the API posts page. *@
                    <a class="nav-link modern-nav-link"
                       asp-controller="Home"
                       asp-action="Posts">
                        Posts
                    </a>

                    @* Link to stored patient information. *@
                    <a class="nav-link modern-nav-link"
                       asp-controller="Home"
                       asp-action="PatientInfo">
                        Patient Info
                    </a>

                </div>

            </div>

        </div>

    </nav>

    @* Create the main page container. *@
    <main class="container main-content">

        @* Render the contents of each individual view. *@
        @RenderBody()

    </main>

    @* Create a simple modern footer. *@
    <footer class="modern-footer">

        <div class="container text-center">

            @* Display the project name. *@
            <p class="mb-1">
                <strong>City Care Hospital</strong>
            </p>

            <small>
                Hospital Appointment Management System
            </small>

        </div>

    </footer>

    @* Load Bootstrap JavaScript. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @* Load Bootstrap bundle JavaScript. *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* Load custom application JavaScript. *@
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Allow individual views to add additional scripts. *@
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>